{
	"info": {
		"_postman_id": "a23fbe25-8724-49da-bd17-77a1faa4fa7e",
		"name": "Vhape Dummy API - Suite de Pruebas",
		"description": "Colección simplificada para probar los DSL keywords del API dummy de Vhape:\n- validate token (también prueba expect 401 con token inválido/sin token)\n- access denied",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
		"_exporter_id": "42702550"
	},
	"item": [
		{
			"name": "1. Health Check",
			"item": [
				{
					"name": "Health - GET /api/health",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Estado es healthy\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('healthy');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/health",
							"host": ["{{base_url}}"],
							"path": ["api", "health"]
						},
						"description": "Endpoint público para verificar que el servidor está funcionando"
					},
					"response": []
				}
			],
			"description": "Endpoint público sin autenticación"
		},
		{
			"name": "2. Users - Get Current User Profile",
			"item": [
				{
					"name": "Get My Profile - Token Válido",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Perfil de usuario obtenido\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('user_id');",
									"    pm.expect(jsonData).to.have.property('role');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{valid_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users/me",
							"host": ["{{base_url}}"],
							"path": ["api", "users", "me"]
						},
						"description": "DSL keyword: validate token\nObtener perfil del usuario actual con token válido. Retorna 200."
					},
					"response": []
				},
				{
					"name": "Get My Profile - Token Inválido",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Respuesta indica token inválido\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('detail');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{invalid_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/users/me",
							"host": ["{{base_url}}"],
							"path": ["api", "users", "me"]
						},
						"description": "DSL keywords: validate token / expect 401\nObtener perfil con token inválido. Retorna 401, también prueba el DSL keyword 'expect 401'."
					},
					"response": []
				},
				{
					"name": "Get My Profile - Sin Token",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Respuesta indica token faltante\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.detail).to.include('Missing');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/users/me",
							"host": ["{{base_url}}"],
							"path": ["api", "users", "me"]
						},
						"description": "DSL keywords: validate token / expect 401\nObtener perfil sin token. Retorna 401, también prueba el DSL keyword 'expect 401'."
					},
					"response": []
				}
			],
			"description": "DSL keywords: validate token / expect 401\nEndpoints para obtener perfil del usuario actual. Con token inválido o sin token retorna 401 (expect 401)."
		},
		{
			"name": "3. Admin - Get All Users",
			"item": [
				{
					"name": "Get All Users - Token Usuario (Access Denied)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 403\", function () {",
									"    pm.response.to.have.status(403);",
									"});",
									"",
									"pm.test(\"Respuesta indica acceso denegado\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.detail).to.include('Access denied');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/admin/users",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users"]
						},
						"description": "DSL keyword: access denied\nObtener lista de usuarios con token de usuario (sin permisos admin). Retorna 403."
					},
					"response": []
				},
				{
					"name": "Get All Users - Token Admin (Access Allowed)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Lista de usuarios obtenida\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('users');",
									"    pm.expect(jsonData.users).to.be.an('array');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{valid_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/api/admin/users",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "users"]
						},
						"description": "DSL keyword: access allowed\nObtener lista de usuarios con token admin. Retorna 200."
					},
					"response": []
				}
			],
			"description": "DSL keywords: access denied / access allowed\nEndpoint para obtener lista de usuarios (solo admin). Token usuario retorna 403 (access denied), token admin retorna 200 (access allowed)."
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		}
	]
}
