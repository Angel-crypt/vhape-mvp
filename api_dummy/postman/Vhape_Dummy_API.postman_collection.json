{
	"info": {
		"_postman_id": "vhape-dummy-api-collection",
		"name": "Vhape Dummy API - Suite de Pruebas",
		"description": "Colección simplificada para probar los DSL keywords del API dummy de Vhape:\n- validate token\n- expect 401\n- access denied",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "1. Health Check",
			"item": [
				{
					"name": "Health - GET /health",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						},
						"description": "Endpoint público para verificar que el servidor está funcionando"
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Estado es healthy\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.status).to.eql('healthy');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			],
			"description": "Endpoint público sin autenticación"
		},
		{
			"name": "2. Validate Token",
			"item": [
				{
					"name": "Validate Token - Token Válido",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{valid_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/validate-token",
							"host": ["{{base_url}}"],
							"path": ["validate-token"]
						},
						"description": "DSL keyword: validate token\nEndpoint para probar validación de token con token válido. Debe retornar 200."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Token validado correctamente\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('message');",
									"    pm.expect(jsonData).to.have.property('user_id');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Validate Token - Token Inválido",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{invalid_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/validate-token",
							"host": ["{{base_url}}"],
							"path": ["validate-token"]
						},
						"description": "DSL keyword: validate token\nEndpoint para probar validación de token con token inválido. Debe retornar 401."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Respuesta indica token inválido\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('detail');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Validate Token - Sin Token",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/validate-token",
							"host": ["{{base_url}}"],
							"path": ["validate-token"]
						},
						"description": "DSL keyword: validate token\nEndpoint para probar validación de token sin token. Debe retornar 401."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Respuesta indica token faltante\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.detail).to.include('Missing');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			],
			"description": "DSL keyword: validate token\nEndpoints para probar validación de tokens (válidos, inválidos, faltantes)"
		},
		{
			"name": "3. Expect 401",
