									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Expect 401 - Token Inválido",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{invalid_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/expect-401",
							"host": ["{{base_url}}"],
							"path": ["expect-401"]
						},
						"description": "DSL keyword: expect 401\nEndpoint para probar escenario con token inválido. Debe retornar 401."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 401\", function () {",
									"    pm.response.to.have.status(401);",
									"});",
									"",
									"pm.test(\"Respuesta indica token inválido\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('detail');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			],
			"description": "DSL keyword: expect 401\nEndpoints para probar escenarios que deben retornar 401 (no autorizado)"
		},
		{
			"name": "4. Access Denied",
			"item": [
				{
					"name": "Access Denied - Token Usuario",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{user_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/access-denied",
							"host": ["{{base_url}}"],
							"path": ["access-denied"]
						},
						"description": "DSL keyword: access denied\nEndpoint para probar acceso denegado con token de usuario en endpoint admin. Debe retornar 403."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 403\", function () {",
									"    pm.response.to.have.status(403);",
									"});",
									"",
									"pm.test(\"Respuesta indica acceso denegado\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.detail).to.include('Access denied');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Access Denied - Token Admin",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{valid_token}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/access-denied",
							"host": ["{{base_url}}"],
							"path": ["access-denied"]
						},
						"description": "DSL keyword: access denied\nEndpoint para probar acceso admin con token admin. Debe retornar 200."
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(\"Código de estado es 200\", function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test(\"Acceso concedido\", function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.message).to.include('granted');",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			],
			"description": "DSL keyword: access denied\nEndpoints para probar acceso denegado (403) cuando un usuario sin permisos intenta acceder"
		}
	],
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [""]
			}
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8000",
			"type": "string"
		}
	]
}
